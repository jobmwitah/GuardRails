[Unit]
Description=GuardRails MT5 terminal (Wine staging)
After=network.target guardrails-xvfb.service
Requires=guardrails-xvfb.service

[Service]
Type=simple
User=guardrails
Group=guardrails
Environment=HOME=/opt/guardrails
Environment=WINEPREFIX=/opt/guardrails/mt5/wineprefix-staging
Environment=WINEDEBUG=-all
Environment=WINEDLLOVERRIDES=mscoree,mshtml=
Environment=DISPLAY=:1
WorkingDirectory=/opt/guardrails/mt5/61603648
ExecStart=/opt/guardrails/tools/run-mt5.sh
ExecStop=/opt/wine-staging/bin/wineserver -k
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
