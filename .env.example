# BRIDGE_TOKEN may list multiple tokens during rotation: new-token,old-token
BRIDGE_TOKEN="random-string"
DISCORD_TOKEN="bot-token"
OWNER_DISCORD_ID="user-id(turnon-developer-options)"
ALERT_CHANNEL_ID="alert-channel-id"
GUILD_ID="server-id"

# Public HTTPS URL used for one-time MT5 password forms and by the Windows agent.
PUBLIC_BASE_URL="https://your-public-host"

# Fernet key for encrypting provisioning payloads at rest.
# Generate once, keep it stable, never commit it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY="replace-with-generated-fernet-key"

# Shared secret for the Windows provisioning agent. Generate a long random
# string and put the same value in agent/config.json.
AGENT_TOKEN="replace-with-long-random-agent-token"

# Optional tuning
PROVISION_TOKEN_TTL=900
AGENT_STALE_SECONDS=90

# Optional $-based rules (0 = disabled)
DAILY_LOSS_LIMIT=0
MAX_DRAWDOWN_PCT=0
MAX_LOT_SIZE=0
MAX_POSITIONS=0
