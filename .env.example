# BRIDGE_TOKEN may list multiple tokens during rotation: new-token,old-token
BRIDGE_TOKEN="random-string"
DISCORD_TOKEN="bot-token"
OWNER_DISCORD_ID="user-id(turnon-developer-options)"
ALERT_CHANNEL_ID="alert-channel-id"
GUILD_ID="server-id"

# Public HTTPS origin used for cTrader OAuth links and the PWA.
PUBLIC_BASE_URL="https://your-public-host"

# Fernet key for encrypting OAuth tokens at rest.
# Generate once, keep it stable, never commit it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY="replace-with-generated-fernet-key"

# Optional tuning: lifetime of one-time cTrader OAuth links, in seconds.
PROVISION_TOKEN_TTL=900

# Optional $-based rules (0 = disabled)
DAILY_LOSS_LIMIT=0
MAX_DRAWDOWN_PCT=0
MAX_LOT_SIZE=0
MAX_POSITIONS=0

# ---------------- cTrader Open API (demo MVP) ----------------
# Register an application at https://openapi.ctrader.com. Add the redirect URI
# under Applications -> Edit -> Redirect URIs: the literal value of
# PUBLIC_BASE_URL plus /ctrader/callback (no angle brackets, spaces, or
# trailing slash), for example https://bot.example.com/ctrader/callback.
# Request the "trading" scope. These values must exist only in the VPS
# environment / .env; never commit real credentials.
CTRADER_CLIENT_ID="replace-with-ctrader-client-id"
CTRADER_CLIENT_SECRET="replace-with-ctrader-client-secret"
# Optional when it matches PUBLIC_BASE_URL + /ctrader/callback
# CTRADER_REDIRECT_URI="https://your-public-host/ctrader/callback"

# Shared secret between the backend and the local connector process. Generate a
# long random string; it is accepted only for ctrader: accounts.
CTRADER_CONNECTOR_TOKEN="replace-with-long-random-connector-token"

# Mobile PWA API authentication token (generate a secure random string)
# Used by the mobile PWA to authenticate API requests.
MOBILE_API_TOKEN="replace-with-mobile-api-token"

# CORS origins allowed to access the mobile API (comma-separated)
# Update this for your deployment domain when going live.
MOBILE_CORS_ORIGINS="http://localhost:5173,https://localhost,http://localhost,capacitor://localhost"

# Account logins that should be read-only in the mobile app
# (can view positions but cannot trade). FTMO terminal is protected by default.
MOBILE_READ_ONLY_ACCOUNTS="1515282832"

# Optional: explicit opt-in for trading accounts (comma-separated list of logins)
# If set, only these accounts can trade (others default to read-only)
# MOBILE_TRADE_ACCOUNTS="1345721557,61603648"

# Connector-only settings (the backend ignores these).
CTRADER_BACKEND_URL="http://127.0.0.1:8000"
# CTRADER_STATE_DIR="ctrader_connector/state"
# Map a Discord symbol root to the broker's exact cTrader symbol name:
# CTRADER_SYMBOL_ALIASES='{"US100": "US100.cash", "XAUUSD": "GOLD"}'
# CTRADER_MARGIN_CAP_PCT=80
# CTRADER_LOG_LEVEL="INFO"
